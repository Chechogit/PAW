@model IEnumerable<PAW.Web.Models.Product>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nuevo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Rating</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Description</td>
                <td>@item.Category?.CategoryName</td>
                <td>@item.Inventory?.UnitPrice</td>
                <td>@item.Rating</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ProductId">Ver detalle</a> |
                    <a asp-action="Edit" asp-route-id="@item.ProductId">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.ProductId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
